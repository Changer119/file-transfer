{
  "extends": "./base.json",
  "include": [
    "../src/main/**/*",
    "../src/preload/**/*",
    "../src/shared/**/*",
    "../tests/**/*",
    "../electron.vite.config.ts",
    "../vitest.config.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "paths": {
      "@shared/*": ["../src/shared/*"],
      "@main/*": ["../src/main/*"]
    }
  }
}
