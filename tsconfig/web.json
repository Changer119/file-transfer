{
  "extends": "./base.json",
  "include": ["../src/renderer/**/*", "../src/shared/**/*"],
  "compilerOptions": {
    "composite": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@renderer/*": ["../src/renderer/*"],
      "@shared/*": ["../src/shared/*"]
    }
  }
}
